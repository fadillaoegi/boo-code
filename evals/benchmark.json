{
  "schemaVersion": 1,
  "name": "Boo agent regression benchmark",
  "description": "Kasus coding, debugging, instruksi proyek, penelusuran, dan perubahan multi-file untuk mendeteksi regresi perilaku agent.",
  "model": "auto",
  "cases": [
    {
      "id": "fix-add",
      "prompt": "Perbaiki implementasi add agar seluruh test lulus. Jangan ubah test. Jalankan `node --test` untuk verifikasi.",
      "fixture": "fixtures/fix-add",
      "tags": ["debugging", "javascript"],
      "difficulty": "standard",
      "allowedCommands": ["node --test"],
      "expect": {
        "files": [
          { "path": "app.js", "contains": "return a + b", "notContains": "return a - b" },
          { "path": "app.test.js", "sha256": "90def2748f49692a604e6b3ef99bb471bbfac4629df6c5dc281b795a1fc04247" }
        ],
        "requiredTools": ["bash"],
        "requireVerification": true,
        "maxTurns": 8,
        "maxToolCalls": 10
      }
    },
    {
      "id": "fix-discount",
      "prompt": "Temukan dan perbaiki bug perhitungan diskon. Jangan ubah test dan jalankan `node --test` untuk verifikasi.",
      "fixture": "fixtures/fix-discount",

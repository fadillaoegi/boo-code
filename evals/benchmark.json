      "expect": {
        "files": [
          { "path": "price.js", "contains": "/ 100", "notContains": "return price - percent" },
          { "path": "price.test.js", "sha256": "c7091fa0b960afb54dfe39cc3eb0c1da68647e6b1c9d39d890ae90ebd72035d3" }
        ],
        "requiredTools": ["bash"],
        "requireVerification": true,
        "maxTurns": 8,
        "maxToolCalls": 12
      }
    },
    {

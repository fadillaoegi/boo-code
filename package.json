{
  "name": "boo-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "boo": "node packages/cli/src/index.ts",
    "link": "pnpm --filter boo-code link --global",
    "unlink": "pnpm --filter boo-code unlink --global",
    "lint": "eslint .",
    "test": "node --test packages/*/tests/*.test.ts",
    "eval": "node scripts/eval.ts",
    "eval:validate": "node scripts/eval.ts evals/benchmark.json --validate",
    "eval:smoke": "node scripts/eval.ts evals/smoke.json",
    "eval:benchmark": "node scripts/eval.ts evals/benchmark.json",
    "test:providers:live": "node scripts/provider-live.ts",
    "typecheck": "tsc -b",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "0.8.0"
  }
}
